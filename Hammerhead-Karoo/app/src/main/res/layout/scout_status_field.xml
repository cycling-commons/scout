<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scout_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF101418"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/scout_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FF4CAF50"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scout_tags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scout_open_surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#338E5A2B"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="#FF8E5A2B"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scout_radar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#FFB0BEC5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/scout_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#FF78909C"
        android:textSize="11sp" />
</LinearLayout>
