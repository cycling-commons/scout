    <!-- Intro -->
    <string name="intro_powering">qui alimente</string>
    <string name="intro_point_tag">Appuyez sur une tuile pour marquer dangers, fermetures, surfaces et ravitaillement sur votre sortie.</string>
    <string name="intro_point_photo">Pendant l\'enregistrement, vous pouvez prendre ou choisir une photo et ajouter une courte note. Facultatif — le marquage fonctionne sans.</string>
    <string name="intro_point_radar">Associez un radar vélo pour enregistrer les dépassements — optionnel, et désactivé jusqu\'à activation.</string>
    <string name="intro_point_private">Les marqueurs restent dans un fichier FIT sur ce téléphone ; photos et notes à côté. Pas de compte, pas d\'envoi — du moins pas automatiquement.</string>
    <string name="intro_permissions_title">Autorisations</string>
    <string name="intro_permission_location">Localisation (précise) : votre trace GPS et l\'emplacement des marqueurs sur la carte.</string>
    <string name="intro_permission_notifications">Notifications : l\'indicateur de sortie en cours.</string>
    <string name="intro_permission_bluetooth">Appareils à proximité : uniquement si vous associez un radar BLE plus tard — le marquage fonctionne sans.</string>
    <string name="intro_permission_camera">Appareil photo : uniquement si vous prenez une photo pendant une sortie. Choisir une image dans la galerie utilise le sélecteur système et n\'en a pas besoin.</string>
    <string name="intro_permissions_when">Android demande cela après avoir appuyé sur Commencer. Vous pouvez modifier ces choix dans les paramètres système.</string>
    <string name="intro_legal_title">Sécurité &amp; mentions légales</string>
    <string name="intro_legal_summary">Scout enregistre vos sorties ; ce n\'est pas une navigation ni une protection en cas d\'accident. Votre sortie reste sur cet appareil jusqu\'à ce que vous la partagiez.</string>
