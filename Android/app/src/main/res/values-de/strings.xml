    <!-- Intro -->
    <string name="intro_powering">die die</string>
    <string name="intro_point_tag">Tippe auf eine Kachel, um Gefahren, Sperrungen, Oberflächen und Verpflegung auf deiner Fahrt zu markieren.</string>
    <string name="intro_point_radar">Koppel ein Fahrradradar, um überholenden Verkehr zu protokollieren — optional und aus, bis du es aktivierst.</string>
    <string name="intro_point_private">Alles bleibt in einer FIT-Datei auf diesem Telefon. Kein Konto, kein Upload — zumindest nicht automatisch.</string>
    <string name="intro_permissions_title">Berechtigungen</string>
    <string name="intro_permission_location">Standort (genau): deine GPS-Spur und wo Markierungen auf der Karte landen.</string>
    <string name="intro_permission_notifications">Benachrichtigungen: der Hinweis auf eine laufende Fahrt.</string>
    <string name="intro_permission_bluetooth">Geräte in der Nähe: nur wenn du später ein BLE-Radar koppelst — Markieren funktioniert auch ohne.</string>
    <string name="intro_permissions_when">Android fragt nach dem Tippen auf Los geht\'s. Du kannst das jederzeit in den Systemeinstellungen ändern.</string>
    <string name="intro_legal_title">Sicherheit &amp; Rechtliches</string>
